---
import TerminalBlock from '../components/TerminalBlock.astro';
import course from '../data/course.json';
import WorkstationTargets from '../components/WorkstationTargets.astro';
import ReadinessCheck from '../components/ReadinessCheck.astro';
import InstallGuide from '../components/InstallGuide.astro';
import LabWalkthrough from '../components/LabWalkthrough.astro';
import {walkthroughs,learnerRepository,cloneWorkspace} from '../data/walkthroughs.js';
import '../styles/course.css';
import '../styles/themes.css';
const base=import.meta.env.BASE_URL;
const clock=(n:number)=>`${Math.floor(n/60)}:${String(Math.floor(n%60)).padStart(2,'0')}`;
const lessonCount=course.chapters.filter(c=>!c.opening).length;
const total=course.tracks.reduce((a,t)=>a+t.length,0);
const moduleGroups=course.modules.map((m,i)=>m.sections ?? [{id:null,title:null}]);
---
<!doctype html>
<html lang="en" data-theme="light">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta id="theme-color" name="theme-color" content="#f5f3ec"/><meta name="description" content="An accessible, audio-guided course for developers learning containers, Kubernetes, and reproducible systems. Learn with original narration, explorable diagrams, and evidence-led practice."/><title>Containers in Practice · The learning studio</title><link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml"/><script is:inline id="theme-init">try{const preferences=JSON.parse(localStorage.getItem("cip-studio-preferences")||"{}");if(preferences.theme==="dark"){document.documentElement.dataset.theme="dark";document.getElementById("theme-color").content="#14231d";}}catch{}</script></head>
<body>
<a class="skip" href="#lesson-content">Skip to lesson</a>
<header class="topbar"><a class="brand" href="#opening" aria-label="Containers in Practice, opening"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 2 29 9v14l-13 7L3 23V9Z M3 9l13 7 13-7 M16 16v14"/></svg><span>CONTAINERS<span class="brand-second">IN PRACTICE</span></span></a><div class="top-context"><span class="status-dot"></span> THE LEARNING STUDIO <span class="slash">/</span> <span>01 — 05</span></div><div class="header-actions"><button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to dark theme"><span id="theme-icon" aria-hidden="true">☾</span><span id="theme-label" class="desktop-label">Dark theme</span></button><button id="glossary-open">A–Z <span class="desktop-label">Glossary</span></button><button id="panels-toggle" type="button" aria-expanded="false" aria-controls="course-nav resources-drawer" aria-label="Expand all panels" title="Expand all panels"><svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><rect x="2" y="4" width="16" height="12" rx="1.5"/><path d="M6 4v12M14 4v12"/></svg><span id="panels-label" class="desktop-label">Expand panels</span><span class="panel-mobile-label">Panels</span></button><button id="settings-open" aria-label="Learning preferences">☷ <span class="desktop-label">Preferences</span></button></div></header>
<div class="studio">
<button id="nav-toggle" type="button" aria-expanded="false" aria-controls="course-nav"><span class="eyebrow">Lessons</span></button>
<aside class="sidebar" id="course-nav" aria-label="Course lessons"><div class="side-heading"><div class="lessons-drawer-top"><span id="lessons-drawer-title" class="eyebrow">Lessons</span><button id="nav-close" type="button" aria-label="Close lessons">✕</button></div><div class="side-intro"><p>Small steps.<br/>Real understanding.</p></div><a id="module-context" class="module-context" href="#opening" data-go="opening" aria-label="Opening · return to the welcome lesson"><span id="context-number" class="context-number">−0.1</span><span class="context-copy"><strong id="context-title">Opening</strong><small id="context-subtitle">Welcome · before Module 0</small></span></a></div>
<div class="side-scroll" id="lesson-scroll"><nav aria-label="Modules and chapters"><a href="#opening" data-go="opening" class="chapter-link opening-link"><span class="chapter-number">−0.1</span><span>Course opening</span><span class="done-mark" aria-hidden="true"></span></a>
{course.modules.map((m,i)=><details class="module" open={false} data-module={i}><summary><span class="module-number">{i}</span><span>{m.title}<small>{m.subtitle}</small></span><span class="module-chevron" aria-hidden="true">⌄</span></summary><div class="module-lessons">{moduleGroups[i].map(group=><div data-module-section={group.id || undefined} role={group.id ? 'group' : undefined} aria-labelledby={group.id ? `section-${group.id}` : undefined}>
{group.id && <h3 class="module-section-heading" id={`section-${group.id}`}><span>Module {group.id}</span>{group.title}</h3>}
{course.chapters.filter(c=>c.module===i && !c.opening && (!group.id || c.section===group.id)).map(c=><a href={`#${c.id}`} data-go={c.id} class="chapter-link"><span class="chapter-number">{c.lesson.replace(/^0/,'')}</span><span>{c.title}</span><span class="done-mark" aria-hidden="true"></span></a>)}
</div>)}</div></details>)}
</nav><div class="side-footer"><div><span class="eyebrow">YOUR PROGRESS</span><span id="progress-count">0 / 44</span></div><progress id="progress-meter" max="44" value="0" aria-label="Lessons marked complete"></progress><p>Saved on this device</p></div></div></aside>
<main id="main">
<section class="course-hero" aria-labelledby="course-title"><div><span class="eyebrow hero-kicker"><span class="tiny-cross" aria-hidden="true">✳</span> A COURSE FOR CURIOUS DEVELOPERS</span><h1 id="course-title">Make it run.<br/><span>Know why.</span></h1><p>Containers, without the leap of faith.<br/>Listen, explore, then prove it in your terminal.</p><div class="hero-meta"><span>5 modules</span><span>Opening + {lessonCount} lessons</span><span>{Math.round(total/60)} min of narration</span></div></div><div class="hero-art"><svg viewBox="0 0 280 235" aria-hidden="true" focusable="false"><defs><pattern id="dots" width="15" height="15" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r=".8" fill="#adafa2"/></pattern></defs><rect x="-140" width="420" height="235" fill="url(#dots)"/><path d="m34 162 108-61 108 61-108 61Z" fill="#e7e8de" stroke="#929a8d"/><g class="iso-layer" data-layer="bottom"><path d="m71 146 71-40 71 40v28l-71 40-71-40Z" fill="#234943"/><path d="m71 146 71-40 71 40-71 40Z" fill="#c6d5c5" stroke="#264c43"/><path d="m142 186 71-40v28l-71 40Z" fill="#385f52"/><path d="m87 154 38 21" stroke="#e2ece0" stroke-width="2"/><circle class="hero-status" cx="184" cy="174" r="3" fill="#e5bb67"/></g><g class="iso-layer" data-layer="middle"><path d="m71 104 71-40 71 40v28l-71 40-71-40Z" fill="#cad0c0" stroke="#526552"/><path d="m71 104 71-40 71 40-71 40Z" fill="#e7ecdf" stroke="#526552"/><path d="m142 144 71-40v28l-71 40Z" fill="#a6b99d"/><path d="m89 113 38 21" stroke="#50654e" stroke-width="2"/></g><g class="iso-layer" data-layer="top"><path d="m71 62 71-40 71 40v28l-71 40-71-40Z" fill="#df6f43" stroke="#914320"/><path d="m71 62 71-40 71 40-71 40Z" fill="#f4ab7c" stroke="#914320"/><path d="m142 102 71-40v28l-71 40Z" fill="#d78054"/><path d="m116 65 26-15 26 15-26 15Z" fill="#ffdfbc" stroke="#914320"/><path d="m116 65v10l26 15 26-15V65 M142 80v10" fill="none" stroke="#914320"/></g><text x="8" y="26" font-size="10" font-family="monospace" fill="#53635a">BUILD / RUN / UNDERSTAND</text></svg><div class="hero-art-footer"><span class="art-label" aria-hidden="true">ONE SYSTEM · MANY LAYERS</span><button id="hero-motion-toggle" class="hero-motion-toggle" type="button" aria-label="Pause the container illustration animation">Pause</button></div></div></section>
<div class="lesson-toolbar"><div class="lesson-toolbar-copy"><div class="lesson-toolbar-meta"><span class="eyebrow" id="lesson-breadcrumb">OPENING / WELCOME</span><span id="lesson-position">BEFORE MODULE 0</span></div><h2 id="lesson-title">{course.chapters[0].heading}</h2></div></div>
<div id="lesson-content" tabindex="-1">
{course.chapters.map((c,i)=><article data-lesson={c.id} id={c.id} class="lesson" aria-label={c.heading}><div class="lesson-heading"><span class="lesson-tag">{c.opening ? 'OPENING · MODULE −0.1' : c.section ? `MODULE ${c.lesson} · ${c.kind}` : c.kind}</span><h2 class="lesson-inline-title">{c.heading}</h2><p class="lesson-lede">{c.description}</p>{c.id==='preflight'&&<div class="setup-callout git-primer-callout"><span><strong>Before your first Git commands</strong><small>Get comfortable with repositories, staging and commits.</small></span><button id="primer-open" aria-haspopup="dialog" aria-controls="primer-dialog">New to Git? Start here <span aria-hidden="true">↗</span></button></div>}{c.opening && <><div class="opening-prose">{c.paragraphs.map(t=><p>{t}</p>)}</div><WorkstationTargets/><details class="readiness-disclosure"><summary>Check your available resources</summary><ReadinessCheck/></details><div class="opening-prose"><a href="#baseline" data-go="baseline" class="text-link">Begin Module 0: establish your baseline →</a></div></>}<div class="term-links"><span>Quick definitions</span>{c.terms.map(t=><button data-define={t}>{t} ↗</button>)}</div></div><div class="lesson-tabs" role="tablist" aria-label={`${c.title} views`}><button role="tab" aria-selected="true" aria-controls={`${c.id}-understand`} id={`${c.id}-tab-understand`} data-tab="understand">01 <span>Understand</span></button><button role="tab" aria-selected="false" tabindex="-1" aria-controls={`${c.id}-practice`} id={`${c.id}-tab-practice`} data-tab="practice">02 <span>Investigate</span></button></div>
<section role="tabpanel" aria-labelledby={`${c.id}-tab-understand`} id={`${c.id}-understand`} data-pane="understand"><figure class="scene-shell"><div class="scene-heading"><span class="eyebrow">THE SYSTEM, EXPLAINED</span><span class="scene-counter">STEP <span data-scene-step>01</span> / 03</span></div><div class="diagram-mount" data-diagram={c.id} aria-hidden="true"></div><figcaption><span class="caption-mark" aria-hidden="true">↳</span><span data-scene-caption>{c.steps[0].text}</span></figcaption><div class="scene-footer"><span>Illustrative model · test the claim locally</span><div><button data-scene-play aria-label="Play diagram animation">▶ Animate</button><button data-scene-reset aria-label="Reset diagram">↺</button></div></div></figure>
<div class="insight"><span class="eyebrow">THE IDEA TO KEEP</span><p>{c.insight}</p></div>
{c.aside&&<div class="boundary"><strong>A useful distinction</strong><p>{c.aside}</p></div>}
{c.id==='preflight'&&<InstallGuide stage="workspace" prefix="workspace-install"/>}
{c.id==='toolchain'&&<InstallGuide/>}
{walkthroughs[c.id]&&<LabWalkthrough guide={walkthroughs[c.id]} id={c.id}/>}
{c.id==='toolchain'&&<div class="tool-grid">{['Podman|Run containers','Buildah|Build images','Skopeo|Inspect & transfer images','OpenTofu|Declare infrastructure','Git|Keep a reviewable history','curl|Send an HTTP request'].map(t=><div><strong>{t.split('|')[0]}</strong><span>{t.split('|')[1]}</span></div>)}</div>}


<details class="text-alternative"><summary>Read the diagram step by step</summary><ol>{c.diagramText.map(s=><li><strong>{s.title}</strong><p>{s.text}</p></li>)}</ol></details></section>
<section role="tabpanel" aria-labelledby={`${c.id}-tab-practice`} id={`${c.id}-practice`} data-pane="practice" hidden><span class="eyebrow">YOUR LOCAL INVESTIGATION</span><h3>{c.prompt}</h3><p class="practice-intro">Work in your own terminal. Observe first, change one thing, and save the result.</p><ol class="mission-list">{c.tasks.map((t,j)=><li><span>0{j+1}</span><p>{t}</p></li>)}</ol><div class="evidence-target"><span class="eyebrow">WHAT TO BRING BACK</span><p>{c.proof}</p></div><details class="recovery-hint"><summary>Need a foothold?</summary><p>{c.recovery}</p><p>Open Resources in the lesson toolbar for command starters and reference pages.</p></details><a class="text-link" href={learnerRepository} target="_blank" rel="noopener noreferrer">Open the learner repository ↗</a><p class="fine-print">Clone the student workspace in Module 0.1, then carry your configured workload through the modules. Use the repository’s <a class="text-link" href={`${learnerRepository}/blob/main/docs/vetting.md`} target="_blank" rel="noopener noreferrer">solution checks</a> to vet the observations they cover.</p></section>
<footer class="lesson-bottom"><label class="completion"><input type="checkbox" data-complete={c.id}/><span>{c.opening ? 'I’m ready to check my workstation' : 'I can support this lesson’s claim with evidence'}</span></label><div class="lesson-navigation">{i>0?<a href={`#${course.chapters[i-1].id}`} data-go={course.chapters[i-1].id}>← Previous</a>:<span>Start here</span>}{i < course.chapters.length - 1 ?<a class="next-link" href={`#${course.chapters[i+1].id}`} data-go={course.chapters[i+1].id}>Next lesson <span aria-hidden="true">→</span></a>:<span>End of course</span>}</div></footer></article>)}
</div><noscript><p class="boundary">All lessons and investigations are readable below. Enable JavaScript for diagrams and narration navigation.</p><audio controls src={`${base}audio/course-opening.mp3`}></audio></noscript>
</main>
<button id="resources-toggle" type="button" aria-expanded="false" aria-controls="resources-drawer"><span class="eyebrow">Resources</span></button>
<aside class="resources" id="resources-drawer" aria-label="Lesson resources"><div class="resources-title"><div><span class="eyebrow">IN YOUR CORNER</span><h2 id="resources-title">Resources</h2></div><button id="resources-close" type="button" aria-label="Close resources">✕</button></div><section class="step-overview"><span class="eyebrow">THE WALKTHROUGH</span><ol id="scene-steps">{course.chapters[0].steps.map((s,i)=><li><button data-step={i} aria-current={i===0?'step':undefined}><span class="step-number">0{i+1}</span><span><strong>{s.title}</strong><small>{s.text}</small></span></button></li>)}</ol></section><section class="reference-area"><span class="eyebrow">GO TO THE SOURCE</span><div id="reference-links">{course.chapters[0].resourcesResolved.map(r=><a href={r.url} target="_blank" rel="noopener noreferrer"><strong>{r.title} <span aria-hidden="true">↗</span></strong><span>{r.detail}</span></a>)}</div></section><details class="command-crib"><summary>Terminal starters <span aria-hidden="true">+</span></summary><p>Examples to adapt in your local environment.</p><TerminalBlock code={course.chapters[0].code} codeId="command-code" label="Command reference"/><button id="copy-commands">Copy commands</button><span id="copy-status" role="status"></span></details><div class="resource-bottom"><span class="small-star" aria-hidden="true">✳</span><p>Stay curious.<br/>Keep the evidence.</p></div></aside>
</div>
<footer class="audio-dock" aria-label="Course narration"><audio id="course-audio" preload="auto"></audio><div class="audio-info"><span class="eyebrow">NOW EXPLORING</span><strong id="now-title">Opening</strong><span id="recording-label">Opening · Module −0.1</span></div><div class="audio-controls"><button id="back-10" aria-label="Back 10 seconds">↶<small>10</small></button><button id="play" class="play-button" aria-label="Play narration"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 11 7-11 7Z"/></svg></button><button id="forward-10" aria-label="Forward 10 seconds">↷<small>10</small></button></div><div class="audio-timeline"><div class="wave-track"><div id="waveform" aria-hidden="true"></div><input id="audio-seek" class="wave-keyboard" type="range" min="0" max={course.tracks[0].length} step="0.1" value="0" aria-label="Narration position within current module segment" aria-describedby="scrub-help"/></div><span id="scrub-help" class="sr-only">Click or drag the waveform to play from a point in this segment. Use arrow keys on this slider to seek, or Home and End to jump to the start and end.</span><div class="timeline-meta"><span><span id="elapsed">0:00</span> <span class="muted">/ <span id="duration">{clock(course.tracks[0].length)}</span></span></span><span id="audio-status" role="status">Preparing original narration</span></div></div><label class="speed-label"><span class="sr-only">Narration speed</span><select id="speed"><option value="0.75">0.75×</option><option value="1" selected>1×</option><option value="1.25">1.25×</option><option value="1.5">1.5×</option><option value="2">2×</option></select></label></footer>
<dialog id="glossary-dialog"><form method="dialog"><div class="dialog-top"><span class="eyebrow">NO ASSUMED VOCABULARY</span><button aria-label="Close glossary">✕</button></div></form><h2>A little translation</h2><label class="search"><input id="glossary-search" type="search" placeholder="Find a term…" aria-label="Find a glossary term"/></label><p class="glossary-pronunciation-note">Pronunciation guides use everyday spelling. CAPITALS mark the stressed syllable.</p><dl>{Object.entries(course.glossary).sort(([a],[b])=>a.localeCompare(b,'en',{sensitivity:'base'})).map(([term,definition])=><div data-term={term}><dt>{term}</dt>{course.glossaryPronunciations[term]&&<dd class="term-pronunciation"><span class="pronunciation-label">Say it</span><span class="pronunciation-spelling">{course.glossaryPronunciations[term].spelling}</span>{course.glossaryPronunciations[term].note&&<small>{course.glossaryPronunciations[term].note}</small>}</dd>}<dd>{definition}</dd></div>)}</dl></dialog>
<dialog id="settings-dialog"><form method="dialog"><div class="dialog-top"><span class="eyebrow">SET YOUR PACE</span><button aria-label="Close preferences">✕</button></div></form><h2>Make room for your way of learning</h2><label class="setting"><span><strong>Color theme</strong><small>Choose a light or dark surface. Saved on this device.</small></span><select id="theme-choice" aria-label="Color theme"><option value="light">Light</option><option value="dark">Dark</option></select></label><label class="setting"><span><strong>Follow the narration</strong><small>Move to the lesson that matches the audio.</small></span><input id="follow-audio" type="checkbox" checked/></label><label class="setting"><span><strong>Reduced motion</strong><small>Use still diagrams and quiet transitions.</small></span><input id="reduced-motion" type="checkbox"/></label><label class="setting"><span><strong>Larger text</strong><small>Add breathing room to lesson text.</small></span><input id="larger-text" type="checkbox"/></label><p class="fine-print">Your choices are remembered on this device. Audio only plays when you choose to start it.</p></dialog>
<dialog id="primer-dialog"><form method="dialog"><div class="dialog-top"><span class="eyebrow">A FIVE-MINUTE FOOTHOLD</span><button aria-label="Close Git primer">✕</button></div></form><h2>Git is your lab notebook</h2><p>A repository contains project files and their recorded history. Clone the learner repository inside the Linux environment prepared in Module 0.1. A GitHub account is not required to clone this public starter or keep local commits.</p><ol class="primer-list"><li><strong>Clone and open the project folder</strong><p>Run once in Linux Bash. If you already cloned this workspace in Module 0.1, open that existing copy with <code>cd ~/containers-practice-starter</code>.</p><TerminalBlock code={cloneWorkspace} label="Linux Bash"/></li><li><strong>Inspect the supplied history</strong><p>The clone already contains history. Inspect it before adding your own observations.</p><TerminalBlock code={'git log --oneline -3\ngit show --stat starter-v0.1.0\ngit status'} label="Project shell"/></li><li><strong>See what changed</strong><p>Record your observations in <code>evidence/baseline.md</code>, then compare the changes.</p><TerminalBlock code={'git status\ngit diff -- evidence/baseline.md'} label="Project shell"/></li><li><strong>Keep a checkpoint</strong><p>Stage your saved observations and review the staged diff before making a separate commit.</p><TerminalBlock code={'git add evidence/baseline.md\ngit diff --cached'} label="Project shell"/><TerminalBlock code={'git commit -m "Record baseline evidence"'} label="Project shell"/></li></ol><p>Before committing, configure your identity for this repository with <code>git config --local user.name "Your name"</code> and <code>git config --local user.email "you@example.com"</code>.</p><div class="boundary"><strong>Before you commit</strong><p>Keep passwords, tokens, and private keys out of history. Your evidence commits stay local until you push them to a repository you can write to.</p></div><a class="text-link" href={learnerRepository} target="_blank" rel="noopener noreferrer">Open the learner repository ↗</a></dialog>

<script type="application/json" id="course-data" set:html={JSON.stringify(course).replace(/</g,'\\u003c')}></script><script type="application/json" id="base-path" set:html={JSON.stringify(base)}></script>
<script>import '../scripts/course.js';</script>
</body></html>

---
import TerminalBlock from './TerminalBlock.astro';
import {workspaceInstallations,baselineInstallations} from '../data/installations.js';
const {prefix='lesson-install',pickerId=`${prefix}-os`,stage='baseline'}=Astro.props;
const workspace=stage==='workspace';
const installations=workspace?workspaceInstallations:baselineInstallations;
---
<section class="install-guide" data-install-guide>
 <div class="install-intro"><span class="eyebrow">{workspace?'MODULE 0.1 · BEFORE THE CLONE':'MODULE 0.2 · ESTABLISH YOUR BASELINE'}</span><h3>{workspace?'Prepare Linux and Git':'Install and verify your toolchain'}</h3><p>{workspace?'Choose your workstation path. Prepare only the Linux shell and Git here, then follow the clone walkthrough below.':'Use the Linux environment containing your student clone. Install the remaining tools, then save the repository preflight result below.'}</p></div>
 <label class="install-os" for={pickerId}>Where will you run the labs?<select id={pickerId} data-install-os>{installations.map(os=><option value={os.id}>{os.title}</option>)}</select></label>
 <div data-install-content tabindex="-1" class="install-content" aria-label="Installation steps">
  {installations.map(os=><section data-install-platform={os.id} hidden={os.id!=='ubuntu'} aria-labelledby={`${prefix}-${os.id}-heading`}><h4 id={`${prefix}-${os.id}-heading`}>{os.title}</h4><p>{os.intro}</p><ol class="installation-steps">{os.steps.map((step,i)=><li><div class="install-step-heading"><span class="install-step-number">{String(i+1).padStart(2,'0')}</span><div><h5>{step.title}</h5><span class="terminal-context">{step.shell}</span></div></div><p>{step.note}</p><TerminalBlock code={step.code} label={step.shell}/><button type="button" data-install-copy>Copy this step</button><span class="install-copy-status" role="status"></span></li>)}</ol><div class="install-sources"><span>Official guides</span>{os.sources.map(([title,url])=><a href={url} target="_blank" rel="noopener noreferrer">{title} ↗</a>)}</div></section>)}
  {!workspace&&<details class="install-workload"><summary>Before the Node.js investigation in Module 1.1.1</summary><p>That lesson runs the starter API with npm. Install Node.js 24, including npm, inside the same Linux environment, using the <a href="https://nodejs.org/en/download" target="_blank" rel="noopener noreferrer">official Node.js installation instructions ↗</a>. Verify both programs before starting the API.</p><TerminalBlock code={'node --version\nnpm --version'} label="Linux shell"/></details>}
  <p class="fine-print">{workspace?'After Git is ready, clone fussy-stork using the walkthrough below. The six-tool baseline comes in 0.2.':'kind and kubectl come in Module 2. Run the preflight below before recording Checkpoint 0.'}</p>

 </div>
 <noscript><p>All platform instructions are shown below. Choose your platform’s heading.</p></noscript>
</section>
